{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:security": "node --test --test-isolation=none tests/excel-compatibility.test.mjs",
    "test:billing": "node --test tests/billing-pdf.test.mjs tests/pos-billing.test.mjs tests/sales-billing.test.mjs",
    "test:checkout": "node --test tests/credit-checkout.test.mjs tests/pos-billing.test.mjs",
    "test:stock": "node --test tests/stock-adjustments.test.mjs tests/stock-modals.test.mjs tests/stock-availability.test.mjs",
    "preview": "vite preview",
    "prebuild": "node scripts/sync-brand-assets.cjs",
    "brand:sync": "node scripts/sync-brand-assets.cjs",
    "test:pwa": "node --test tests/pwa.test.mjs",
    "test:accounting": "node --test tests/accounting-access.test.mjs tests/seller-views.test.mjs",
    "test:commercial-documents": "node --test tests/commercial-documents.test.mjs tests/bank-accounts-settings.test.mjs tests/billing-pdf.test.mjs tests/sale-note-preview.test.mjs",
    "test:product-billing": "node --test tests/product-billing.test.mjs tests/pos-billing.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "axios": "^1.21.0",
    "lucide-react": "^0.400.0",
    "pdfmake": "^0.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.32",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^6.4.5"
  }
}
